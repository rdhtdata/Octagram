# ----------------------------------------------------------------------
# Hostinger & LiteSpeed / Apache Automatic Cache Invalidation Rules
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  # 1. HTML Documents: Never cache in browser or proxy cache.
  # Forces browsers to always request the latest index.html on every page load.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  # 2. CSS & JS: Re-validate with server or rely on version query strings (?v=...)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Disable LiteSpeed Server Cache for HTML pages if LSCache is active on Hostinger
<IfModule LiteSpeed>
  CacheLookup public off
</IfModule>
